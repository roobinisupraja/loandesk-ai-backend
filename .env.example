OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=loandesk
CORS_ORIGINS=http://localhost:3000

# SMTP (leave SMTP_HOST empty to only save emails to the outbox table)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=LoanDesk AI <youraddress@gmail.com>
SMTP_STARTTLS=true

# Scheduler
MAX_ACTIVE_APPLICATIONS=3
SCHEDULER_POLL_SECONDS=3
